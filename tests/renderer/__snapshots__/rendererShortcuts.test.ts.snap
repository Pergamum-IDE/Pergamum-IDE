exports[`resolveRendererShortcutKeybindings (#643) > darwin: binding snapshot 1`] = `
[
  {
    "commandId": "workbench.commandPalette.file.open",
    "handlerStatus": "callbackDirect",
    "key": "Mod-o",
    "platform": "darwin",
    "scope": "app",
    "source": "pergamum",
    "when": "workbenchFocus && !modalOpen",
  },
  {
    "commandId": "workbench.commandPalette.glossary.open",
    "handlerStatus": "callbackDirect",
    "key": "Mod-@",
    "platform": "darwin",
    "scope": "app",
    "source": "pergamum",
    "when": "workbenchFocus && !modalOpen",
  },
  {
