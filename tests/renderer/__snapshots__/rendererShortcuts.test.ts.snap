    "key": "Mod-Shift-c",
    "platform": "darwin",
    "scope": "editor",
    "source": "pergamum",
    "when": "editorFocus && markdownDocument && !readOnly",
  },
  {
    "commandId": "workspace.files.toggle",
    "handlerStatus": "registered",
    "key": "Mod-Shift-e",
    "platform": "darwin",
    "scope": "pane",
    "source": "pergamum",
    "when": "workbenchFocus && !modalOpen",
  },
  {
    "commandId": "workspace.glossary.toggle",
    "handlerStatus": "callbackDirect",
    "key": "Mod-Shift-g",
    "platform": "darwin",
    "scope": "pane",
    "source": "pergamum",
    "when": "workbenchFocus && !modalOpen",
  },
  {
    "commandId": "workspace.documentMap.toggle",
    "handlerStatus": "callbackDirect",
    "key": "Mod-Shift-m",
    "platform": "darwin",
    "scope": "pane",
    "source": "pergamum",
    "when": "workbenchFocus && !modalOpen",
  },
  {
    "commandId": "workspace.documentMetrics.toggle",
    "handlerStatus": "callbackDirect",
    "key": "Mod-Shift-t",
    "platform": "darwin",
    "scope": "pane",
    "source": "pergamum",
    "when": "workbenchFocus && !modalOpen",
  },
  {
    "commandId": "workspace.files.rename",
    "handlerStatus": "callbackDirect",
    "key": "F2",
    "platform": "darwin",
    "scope": "pane",
    "source": "pergamum",
    "when": "fileExplorerFocus",
  },
  {
    "commandId": "workspace.files.copy",
    "handlerStatus": "callbackDirect",
    "key": "Mod-c",
    "platform": "darwin",
    "scope": "pane",
    "source": "pergamum",
    "when": "fileExplorerFocus",
  },
  {
    "commandId": "workspace.files.cut",
    "handlerStatus": "callbackDirect",
    "key": "Mod-x",
    "platform": "darwin",
    "scope": "pane",
    "source": "pergamum",
    "when": "fileExplorerFocus",
  },
  {
    "commandId": "workspace.files.paste",
    "handlerStatus": "callbackDirect",
    "key": "Mod-v",
    "platform": "darwin",
    "scope": "pane",
    "source": "pergamum",
    "when": "fileExplorerFocus",
  },
  {
    "commandId": "workspace.files.delete",
    "handlerStatus": "callbackDirect",
    "key": "Delete",
    "platform": "darwin",
    "scope": "pane",
    "source": "pergamum",
    "when": "fileExplorerFocus",
  },
  {
    "commandId": "editor.preview.toggle",
    "handlerStatus": "registered",
    "key": "Mod-Shift-p",
    "platform": "darwin",
    "scope": "editor",
    "source": "pergamum",
    "when": "activeMarkdownDocument",
  },
  {
    "commandId": "editor.image.insert",
    "handlerStatus": "registered",
    "key": "Mod-Shift-i",
    "platform": "darwin",
    "scope": "editor",
    "source": "pergamum",
    "when": "editorFocus && markdownDocument && !readOnly",
  },
  {
    "commandId": "workspace.tabs.previous",
    "handlerStatus": "callbackDirect",
    "key": "Mod-Alt-ArrowLeft",
    "platform": "darwin",
    "scope": "app",
    "source": "pergamum",
    "when": "workbenchFocus && !modalOpen && !textInputFocus",
  },
  {
    "commandId": "workspace.tabs.next",
    "handlerStatus": "callbackDirect",
    "key": "Mod-Alt-ArrowRight",
    "platform": "darwin",
    "scope": "app",
